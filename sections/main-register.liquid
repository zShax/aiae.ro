{%- comment -%}
  Account creation is intentionally disabled — the sign-up form has
  been replaced with a branded notice. Re-enable by restoring the
  Dawn 'create_customer' form from theme history if needed.
{%- endcomment -%}

<div class="aiae-register-off">
  <div class="aiae-eyebrow">{{ section.settings.eyebrow }}</div>
  <h1 class="aiae-display">{{ section.settings.title }}</h1>
  <p>{{ section.settings.message }}</p>
  <a href="{{ routes.root_url }}">{{ section.settings.cta_label }} <span aria-hidden="true">→</span></a>
</div>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CONTURI — MOMENTAN ÎNCHISE" },
    { "type": "text", "id": "title", "label": "Title", "default": "AIA E. FĂRĂ CONT." },
    { "type": "textarea", "id": "message", "label": "Message", "default": "Nu ai nevoie de cont ca să comanzi. Crearea de conturi este dezactivată momentan — comanzi ca oaspete, la fel de simplu." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "ÎNAPOI LA MAGAZIN" }
  ]
}
{% endschema %}
