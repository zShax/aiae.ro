{%- liquid
  assign hero_image = section.settings.image_desktop | default: section.settings.image_mobile
  assign has_media = false
  if section.settings.image_desktop != blank or section.settings.image_mobile != blank
    assign has_media = true
  endif
-%}
<section id="top" class="aiae-hero{% if has_media %} aiae-hero--has-media{% endif %}">

  {%- if has_media -%}
    <div class="aiae-hero__media" data-aiae-reveal="fade" style="--aiae-reveal-delay: 0.05s;">
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 1100 }}">
        {%- endif -%}
        {%- assign fallback_image = hero_image -%}
        <img
          src="{{ fallback_image | image_url: width: 2200 }}"
          srcset="{{ fallback_image | image_url: width: 1100 }} 1100w,
                  {{ fallback_image | image_url: width: 2200 }} 2200w,
                  {{ fallback_image | image_url: width: 3000 }} 3000w"
          sizes="100vw"
          alt="{{ section.settings.image_alt | default: fallback_image.alt | default: shop.name | escape }}"
          width="{{ fallback_image.width }}"
          height="{{ fallback_image.height }}"
          loading="eager"
          fetchpriority="high">
      </picture>
    </div>
  {%- endif -%}

  {%- comment -%} Marquee ticker {%- endcomment -%}
  <div class="aiae-hero__ticker aiae-noscroll" data-aiae-reveal="fade" style="--aiae-reveal-delay: 0.55s;">
    <div class="aiae-marquee-inner">
      {%- assign ticker_items = section.settings.ticker_text | split: '|' -%}
      {%- for item in ticker_items -%}
        <span style="padding:0 28px;">{{ item | strip }}</span>
        <span class="aiae-tick-dot" style="padding:0 28px;">●</span>
      {%- endfor -%}
      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for item in ticker_items -%}
        <span style="padding:0 28px;">{{ item | strip }}</span>
        <span class="aiae-tick-dot" style="padding:0 28px;">●</span>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%}
    Eyebrow + H1 share one measuring box: --fit (the longest word's length)
    caps the headline so no word ever splits or overflows, whatever the copy.
    Short headlines (the AIA.E wordmark) keep the giant cover size.
  {%- endcomment -%}
  <div class="aiae-hero__copy aiae-fitbox">
    <div class="aiae-hero__eyebrow" data-aiae-reveal style="--aiae-reveal-delay: 0.1s;">
      <span class="aiae-idx">(00)</span>
      <span>{{ section.settings.label }}</span>
      <span>— {{ section.settings.sublabel }}</span>
    </div>

    <h1
      class="aiae-hero__headline aiae-fit{% if section.settings.headline.size > 12 %} aiae-hero__headline--long{% endif %}"
      style="{% render 'aiae-fit', text: section.settings.headline %} --aiae-reveal-delay: 0.2s;"
      data-aiae-reveal="rise">
      {{- section.settings.headline | escape | replace: '.', '<span class="aiae-dot">.</span>' | newline_to_br -}}
    </h1>
  </div>

  <div class="aiae-hero__bottom">
    {%- if section.settings.tagline != blank -%}
      <p class="aiae-hero__tagline" data-aiae-reveal style="--aiae-reveal-delay: 0.36s;">{{ section.settings.tagline }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
      <div class="aiae-hero__ctas" data-aiae-reveal style="--aiae-reveal-delay: 0.46s;">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link }}" class="aiae-hero__cta">{{ section.settings.cta_label }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="aiae-hero__cta aiae-hero__cta--ghost">{{ section.settings.cta2_label }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "AIAE Hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Shown on screens wider than 750px. Recommended 2200px+ wide."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Shown on screens up to 749px wide. Falls back to the desktop image if empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describes the image for search engines and screen readers. Falls back to the image's own alt text."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker items (pipe-separated)",
      "default": "TRICOURI ȘI HANORACE PERSONALIZATE|PRINT ON DEMAND — TOATE CULORILE|LIVRARE ÎN TOATĂ ROMÂNIA|BUCUREȘTI / TIMIȘOARA|AIA E. ASTA E."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "TRICOURI PERSONALIZATE"
    },
    {
      "type": "text",
      "id": "sublabel",
      "label": "Eyebrow sublabel",
      "default": "STREETWEAR POST-IRONIC"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline (the page's H1)",
      "info": "Every . becomes an accent dot. Line breaks are kept. Up to 12 characters gets the giant wordmark size.",
      "default": "AIA.E"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Tricouri și hanorace personalizate, printate la comandă. Materiale grele, printuri care rezistă. Tu pui mesajul."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "PERSONALIZEAZĂ ACUM"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "AIAE Hero"
    }
  ]
}
{% endschema %}
