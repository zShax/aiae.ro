<section id="top" class="aiae-hero">

  {%- if section.settings.image_desktop != blank or section.settings.image_mobile != blank -%}
    <div class="aiae-hero__media" data-aiae-reveal="fade" style="--aiae-reveal-delay: 0.05s;">
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 1100 }}">
        {%- endif -%}
        {%- assign fallback_image = section.settings.image_desktop | default: section.settings.image_mobile -%}
        <img
          src="{{ fallback_image | image_url: width: 2200 }}"
          srcset="{{ fallback_image | image_url: width: 1100 }} 1100w,
                  {{ fallback_image | image_url: width: 2200 }} 2200w,
                  {{ fallback_image | image_url: width: 3000 }} 3000w"
          sizes="100vw"
          alt="{{ fallback_image.alt | escape | default: shop.name }}"
          width="{{ fallback_image.width }}"
          height="{{ fallback_image.height }}"
          loading="eager"
          fetchpriority="high">
      </picture>
    </div>
  {%- endif -%}

  {%- comment -%} Marquee ticker {%- endcomment -%}
  <div class="aiae-hero__ticker aiae-noscroll" data-aiae-reveal="fade" style="--aiae-reveal-delay: 0.55s;">
    <div class="aiae-marquee-inner">
      {%- assign ticker_items = section.settings.ticker_text | split: '|' -%}
      {%- for item in ticker_items -%}
        <span style="padding:0 28px;">{{ item | strip }}</span>
        <span class="aiae-tick-dot" style="padding:0 28px;">●</span>
      {%- endfor -%}
      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for item in ticker_items -%}
        <span style="padding:0 28px;">{{ item | strip }}</span>
        <span class="aiae-tick-dot" style="padding:0 28px;">●</span>
      {%- endfor -%}
    </div>
  </div>

  <div class="aiae-hero__eyebrow" data-aiae-reveal style="--aiae-reveal-delay: 0.1s;">
    <span class="aiae-idx">(00)</span>
    <span>{{ section.settings.label }}</span>
    <span>— {{ section.settings.sublabel }}</span>
  </div>

  <h1 class="aiae-hero__headline" data-aiae-reveal="rise" style="--aiae-reveal-delay: 0.2s;">
    {{- section.settings.headline | replace: '.', '<span class="aiae-dot">.</span>' -}}
  </h1>

  <div class="aiae-hero__bottom">
    <p class="aiae-hero__tagline" data-aiae-reveal style="--aiae-reveal-delay: 0.36s;">{{ section.settings.tagline }}</p>
    <a href="{{ section.settings.cta_link }}" class="aiae-hero__cta" data-aiae-reveal style="--aiae-reveal-delay: 0.46s;">{{ section.settings.cta_label }} →</a>
  </div>

</section>

{% schema %}
{
  "name": "AIAE Hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Shown on screens wider than 750px. Recommended 2200px+ wide."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Shown on screens up to 749px wide. Falls back to the desktop image if empty."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker items (pipe-separated)",
      "default": "DEGEABA CLUB 2026 — LOT 200/200|PRINT ON DEMAND — TOATE CULORILE|BUCUREȘTI / TIMIȘOARA|AIA E. ASTA E."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "STREETWEAR POST-IRONIC"
    },
    {
      "type": "text",
      "id": "sublabel",
      "label": "Eyebrow sublabel",
      "default": "ESTE CEEA CE ESTE"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (use . for accent dot)",
      "default": "AIA.E"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Haine pentru oameni care au încetat să se mai prefacă. Design brut, finisaj de lux. Nu schimbă nimic — dar arată bine."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "VEZI COLECȚIA"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    }
  ],
  "presets": [
    {
      "name": "AIAE Hero"
    }
  ]
}
{% endschema %}
