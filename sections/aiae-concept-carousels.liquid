<section id="concept" class="aiae-con">

  <div class="aiae-con__head">
    <div class="aiae-eyebrow" data-aiae-reveal>({{ section.settings.section_number }}) {{ section.settings.eyebrow }}</div>
    <h2 class="aiae-display aiae-con__title" data-aiae-reveal style="--aiae-reveal-delay: 0.12s;">{{ section.settings.title }}</h2>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'carousel_row' -%}
      {%- assign row_collection = collections[block.settings.collection] -%}

      {%- comment -%} Row heading falls back to the collection's own details {%- endcomment -%}
      {%- assign row_title = block.settings.title -%}
      {%- if row_title == blank -%}
        {%- assign row_title = row_collection.title -%}
      {%- endif -%}

      {%- assign row_note = block.settings.note -%}
      {%- if row_note == blank and row_collection.description != blank -%}
        {%- assign row_note = row_collection.description | strip_html | strip | truncate: 90 -%}
        {%- assign row_note = '// ' | append: row_note -%}
      {%- endif -%}

      {%- assign code_prefix = block.settings.code_prefix -%}
      {%- if code_prefix == blank -%}
        {%- assign code_prefix = row_collection.title | strip_html | upcase | slice: 0, 3 | strip -%}
      {%- endif -%}
      {%- assign code_prefix = code_prefix | default: 'CONCEPT' -%}

      <div class="aiae-con__row" {{ block.shopify_attributes }}>
        <div class="aiae-con__rowhead" data-aiae-reveal>
          <h3 class="aiae-con__rowtitle">{{ row_title | default: 'CONCEPT' }}</h3>
          <span class="aiae-con__rownote">{{ row_note }}</span>
          <span class="aiae-con__rowline"></span>
          {%- if block.settings.show_collection_link and row_collection.url != blank -%}
            <a href="{{ row_collection.url }}" class="aiae-con__rowlink">
              <span>{{ block.settings.collection_link_label | default: 'VEZI COLECTIA' }}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>

        <div class="aiae-con__track aiae-noscroll">
          {%- if row_collection != blank and row_collection.products_count > 0 -%}
            {%- for product in row_collection.products limit: block.settings.products_to_show -%}
              {%- assign card_number = product.metafields.aiae.code -%}
              {%- if card_number == blank -%}
                {%- if forloop.index < 10 -%}
                  {%- assign card_number = code_prefix | append: ' 0' | append: forloop.index -%}
                {%- else -%}
                  {%- assign card_number = code_prefix | append: ' ' | append: forloop.index -%}
                {%- endif -%}
              {%- endif -%}

              {%- assign card_sub = product.metafields.aiae.detail -%}
              {%- if card_sub == blank -%}{%- assign card_sub = product.type -%}{%- endif -%}
              {%- if card_sub == blank -%}
                {%- assign card_sub = product.description | strip_html | strip | truncate: 60 -%}
              {%- endif -%}

              <div class="aiae-cc" data-aiae-reveal="right" style="--aiae-reveal-delay: {{ forloop.index0 | times: 0.08 }}s;">
                <a href="{{ product.url }}">
                  <div class="aiae-cc__media" style="background-color:{{ block.settings.card_bg }}; color:{{ block.settings.card_fg }};">
                    {%- if product.featured_image -%}
                      <img src="{{ product.featured_image | image_url: width: 660 }}"
                           alt="{{ product.featured_image.alt | default: product.title | escape }}"
                           width="660"
                           height="{{ 660 | divided_by: product.featured_image.aspect_ratio | round }}"
                           loading="lazy">
                    {%- else -%}
                      <span class="aiae-cc__tag">[ {{ card_number }} ]</span>
                    {%- endif -%}
                    <span class="aiae-cc__num{% if product.featured_image %} aiae-cc__num--over{% endif %}">{{ card_number }}</span>
                    {%- if block.settings.show_sold_out and product.available == false -%}
                      <span class="aiae-cc__flag">SOLD OUT</span>
                    {%- endif -%}
                  </div>
                  <div class="aiae-cc__body">
                    <div class="aiae-cc__row">
                      <h4 class="aiae-cc__title">{{ product.title }}</h4>
                      {%- if block.settings.show_price -%}
                        <span class="aiae-cc__price">{{ product.price | money }}</span>
                      {%- endif -%}
                    </div>
                    {%- if card_sub != blank -%}
                      <p class="aiae-cc__sub">{{ card_sub }}</p>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Placeholder cards while no concept collection is assigned {%- endcomment -%}
            {%- assign placeholder_count = block.settings.products_to_show | default: 5 | at_most: 5 -%}
            {%- for i in (1..placeholder_count) -%}
              <div class="aiae-cc" data-aiae-reveal="right" style="--aiae-reveal-delay: {{ forloop.index0 | times: 0.08 }}s;">
                <div class="aiae-cc__media aiae-cc__media--ph" style="background-color:{{ block.settings.card_bg }}; color:{{ block.settings.card_fg }};">
                  <span class="aiae-cc__tag">[ {{ code_prefix }} 0{{ forloop.index }} ]</span>
                  <span class="aiae-cc__num">{{ code_prefix }} 0{{ forloop.index }}</span>
                </div>
                <div class="aiae-cc__body">
                  <div class="aiae-cc__row">
                    <h4 class="aiae-cc__title">CONCEPT {{ forloop.index }}</h4>
                  </div>
                  <p class="aiae-cc__sub">Alege o colec&#539;ie din set&#259;rile blocului.</p>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
          <div class="aiae-con__spacer"></div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

</section>

{% schema %}
{
  "name": "AIAE Concept Carousels",
  "settings": [
    {
      "type": "text",
      "id": "section_number",
      "label": "Section number",
      "default": "03"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "CONCEPTE — POTENȚIAL DE CUSTOMIZARE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "CE S-AR PUTEA FACE"
    }
  ],
  "blocks": [
    {
      "type": "carousel_row",
      "name": "Concept Row",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Concept collection",
          "info": "The products in this collection become the cards. Around 5 products per collection works best."
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "Products to show",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 5
        },
        {
          "type": "header",
          "content": "Row heading"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Row title",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "text",
          "id": "note",
          "label": "Row note",
          "info": "Leave blank to use the collection description."
        },
        {
          "type": "checkbox",
          "id": "show_collection_link",
          "label": "Show link to collection",
          "default": true
        },
        {
          "type": "text",
          "id": "collection_link_label",
          "label": "Collection link label",
          "default": "VEZI COLECȚIA"
        },
        {
          "type": "header",
          "content": "Cards"
        },
        {
          "type": "text",
          "id": "code_prefix",
          "label": "Card code prefix",
          "info": "Used for the [ PREFIX 01 ] tag. Leave blank to derive it from the collection title. A product's aiae.code metafield always wins."
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show price",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_sold_out",
          "label": "Show sold out badge",
          "default": true
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card media background",
          "default": "#E7E3D8"
        },
        {
          "type": "color",
          "id": "card_fg",
          "label": "Card media foreground",
          "default": "#0D0D0D"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AIAE Concept Carousels",
      "blocks": [
        { "type": "carousel_row", "settings": { "card_bg": "#F2EFE7", "card_fg": "#0D0D0D" } },
        { "type": "carousel_row", "settings": { "card_bg": "#1C1C1C", "card_fg": "#BEBAB2" } },
        { "type": "carousel_row", "settings": { "card_bg": "#23211E", "card_fg": "#BEBAB2" } }
      ]
    }
  ]
}
{% endschema %}
