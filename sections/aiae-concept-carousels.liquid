<section id="concept" class="aiae-con">

  <div class="aiae-con__head">
    <div class="aiae-eyebrow" data-aiae-reveal>({{ section.settings.section_number }}) {{ section.settings.eyebrow }}</div>
    <h2 class="aiae-display aiae-con__title" data-aiae-reveal style="--aiae-reveal-delay: 0.12s;">{{ section.settings.title }}</h2>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'carousel_row' -%}
      <div class="aiae-con__row" {{ block.shopify_attributes }}>
        <div class="aiae-con__rowhead" data-aiae-reveal>
          <h3 class="aiae-con__rowtitle">{{ block.settings.title }}</h3>
          <span class="aiae-con__rownote">{{ block.settings.note }}</span>
          <span class="aiae-con__rowline"></span>
        </div>
        <div class="aiae-con__track aiae-noscroll">
          {%- assign card_count = block.settings.card_count | default: 5 -%}
          {%- for i in (1..card_count) -%}
            {%- assign n_key = 'card_' | append: i | append: '_number' -%}
            {%- assign t_key = 'card_' | append: i | append: '_title' -%}
            {%- assign s_key = 'card_' | append: i | append: '_subtitle' -%}
            {%- assign bg_key = 'card_' | append: i | append: '_bg' -%}
            {%- assign fg_key = 'card_' | append: i | append: '_fg' -%}
            {%- assign n_val = block.settings[n_key] -%}
            {%- assign t_val = block.settings[t_key] -%}
            {%- assign s_val = block.settings[s_key] -%}
            {%- assign bg_val = block.settings[bg_key] | default: '#E7E3D8' -%}
            {%- assign fg_val = block.settings[fg_key] | default: '#0D0D0D' -%}
            {%- if t_val != blank -%}
              <div class="aiae-cc" data-aiae-reveal="right" style="--aiae-reveal-delay: {{ forloop.index0 | times: 0.08 }}s;">
                <div class="aiae-cc__media" style="background:{{ bg_val }}; color:{{ fg_val }};">
                  <span class="aiae-cc__tag">[ {{ n_val }} ]</span>
                  <span class="aiae-cc__num">{{ n_val }}</span>
                </div>
                <div class="aiae-cc__body">
                  <h4 class="aiae-cc__title">{{ t_val }}</h4>
                  <p class="aiae-cc__sub">{{ s_val }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          <div class="aiae-con__spacer"></div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

</section>

