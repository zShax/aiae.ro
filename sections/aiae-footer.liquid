<footer class="aiae-footer">
  <div class="aiae-footer__top">
    <div class="aiae-footer__brand" data-aiae-reveal>
      <div class="aiae-footer__tagline">{{ section.settings.brand_tagline }}</div>
      <p class="aiae-footer__desc">{{ section.settings.brand_description }}</p>
    </div>
    <div class="aiae-footer__cols">
      <div class="aiae-footer__col" data-aiae-reveal style="--aiae-reveal-delay: 0.12s;">
        <span class="aiae-footer__colhead">Magazin</span>
        {%- for block in section.blocks -%}
          {%- if block.type == 'shop_link' -%}
            <a href="{{ block.settings.link }}" class="aiae-flink" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- assign legal_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'legal_link' -%}
          {%- assign legal_count = legal_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if legal_count > 0 -%}
        <div class="aiae-footer__col" data-aiae-reveal style="--aiae-reveal-delay: 0.16s;">
          <span class="aiae-footer__colhead">{{ section.settings.legal_heading }}</span>
          {%- for block in section.blocks -%}
            {%- if block.type == 'legal_link' -%}
              <a
                href="{{ block.settings.link }}"
                class="aiae-flink"
                {% if block.settings.link contains '://' %}
                  target="_blank" rel="noopener"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label -}}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="aiae-footer__col" data-aiae-reveal style="--aiae-reveal-delay: 0.2s;">
        <span class="aiae-footer__colhead">Social</span>
        {%- for block in section.blocks -%}
          {%- if block.type == 'social_link' -%}
            <a href="{{ block.settings.link }}" class="aiae-flink" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.newsletter_enable -%}
      <div class="aiae-footer__news" data-aiae-reveal style="--aiae-reveal-delay: 0.28s;">
        <span class="aiae-footer__colhead">{{ section.settings.newsletter_heading }}</span>
        <p class="aiae-footer__newsnote">{{ section.settings.newsletter_note }}</p>
        {%- form 'customer', id: 'AiaeFooterNewsletter', class: 'aiae-news' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="aiae-news__row">
            <label class="visually-hidden" for="AiaeNewsletter--{{ section.id }}">
              {{- section.settings.newsletter_placeholder -}}
            </label>
            <input
              id="AiaeNewsletter--{{ section.id }}"
              class="aiae-news__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              aria-required="true"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="AiaeNewsletter-error"
              {% endif %}
            >
            <button type="submit" class="aiae-news__btn" name="commit">
              <span>{{ section.settings.newsletter_button_label }}</span>
              <i aria-hidden="true">&rarr;</i>
            </button>
          </div>
          {%- if form.errors -%}
            <small class="aiae-news__msg aiae-news__msg--err" id="AiaeNewsletter-error">
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <small class="aiae-news__msg aiae-news__msg--ok" tabindex="-1">
              {{- section.settings.newsletter_success -}}
            </small>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>

  {%- render 'aiae-support',
    heading: section.settings.support_heading,
    note: section.settings.support_note,
    email: section.settings.support_email,
    phone: section.settings.support_phone,
    hours: section.settings.support_hours,
    link_label: section.settings.support_link_label,
    link_url: section.settings.support_link
  -%}

  <div class="aiae-footer__wordwrap aiae-noscroll" data-aiae-reveal="rise">
    <div id="aiae-footer-word" class="aiae-footer__word">
      <span class="aiae-footer__logo">{{ 'aiae-logo.svg' | inline_asset_content }}</span>
    </div>
  </div>

  {%- comment -%}
    Merchant identification. Required on every page by Legea 365/2002 art. 5
    and OUG 34/2014. Each field renders only once filled in the theme editor.
  {%- endcomment -%}
  {%- capture legal_raw -%}
    {{ section.settings.company_name }}|{{ section.settings.company_cui }}|
    {{- section.settings.company_regcom }}|{{ section.settings.company_address }}|
    {{- section.settings.company_email }}|{{ section.settings.company_phone }}
  {%- endcapture -%}
  {%- assign legal_parts = legal_raw | split: '|' -%}
  {%- capture legal_line -%}
    {%- assign shown = 0 -%}
    {%- for part in legal_parts -%}
      {%- assign part = part | strip -%}
      {%- if part != blank -%}
        {%- if shown > 0 %} · {% endif -%}
        {{ part }}
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign legal_line = legal_line | strip -%}
  {%- if legal_line != blank -%}
    <div class="aiae-footer__legal" data-aiae-reveal="fade">
      <span class="aiae-footer__legalhead">{{ section.settings.company_heading }}</span>
      <p class="aiae-footer__legalline">{{ legal_line }}</p>
    </div>
  {%- endif -%}

  <div class="aiae-footer__bottom" data-aiae-reveal="fade" style="--aiae-reveal-delay: 0.15s;">
    <span>{{ section.settings.copyright }}</span>
    <span class="aiae-footer__madein">{{ section.settings.made_in }}<i></i></span>
  </div>
</footer>

{% schema %}
