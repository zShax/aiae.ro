    },
    {
      "type": "text",
      "id": "support_link_label",
      "label": "Support link label",
      "default": "Politica de retur"
    },
    {
      "type": "url",
      "id": "support_link",
      "label": "Support link URL"
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "info": "Any value shows the AIA.E logo strip; leave blank to hide.",
